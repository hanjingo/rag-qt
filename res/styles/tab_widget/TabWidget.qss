QTabWidget::pane
{
    border-width:0px;
    background-color:#C1CCD6;
    border-top-right-radius:12px;
    border-bottom-left-radius:12px;
    border-bottom-right-radius:12px;
}

QTabWidget::tab-bar
{
    border-width: 0px;
    font-family: '微软雅黑';
    font-size: 12px;
    color: #00467a;
}

QTabBar::tab
{
    font: 12px;
    padding: 0px;
    color: #808080;
    font-size: 12px;
    max-width: 128px;
    min-width: 128px;
    min-height: 35px;
    max-height: 35px;
    font-family: '微软雅黑';
    border-bottom-color:#C1CCD6;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-left: 0px;
    margin-right: 0px;
    margin-top: 0px;
    margin-bottom: 0px;
}

QTabBar::tab:first
{
    margin-left: 0px;
    padding-left: 0px;
}

QTabBar::scroller
{
    width: 128px;
    border: 2px;
    padding: 0px;
}

QTabBar::tab:first:selected
{
    color: #2D3238;
    margin-left: 0px;
    margin-right: 0px;
    background-color:#C1CCD6;
}

QTabBar::tab:first:!selected
{
    color: #2D3238;
    margin-right: 0px;
    background-color:#909AA7;
    margin-left: 0px;
}

QTabBar::tab:middle:selected
{
    color: #2D3238;
    margin-top: 0px;
    margin-left: 8px;
    max-width: 128px;
    min-width: 128px;
    min-height: 35px;
    max-height: 35px;
    margin-right: 0px;
    background-color:#C1CCD6;
}

QTabBar::tab:middle:!selected
{
    color: #2D3238;
    margin-top: 0px;
    margin-left: 8px;
    max-width: 128px;
    min-width: 128px;
    min-height: 35px;
    max-height: 35px;
    margin-right: 0px;
    background-color: #909AA7;
}

QTabBar::tab:last:selected
{
    color: #2D3238;
    margin-top: 0px;
    margin-left: 8px;
    max-width: 128px;
    min-width: 128px;
    min-height: 35px;
    max-height: 35px;
    margin-right:0px;
    background-color:#C1CCD6;
}

QTabBar::tab:last:!selected
{
    color:#2D3238;
    max-width: 128px;
    min-width: 128px;
    min-height: 35px;
    max-height: 35px;
    margin-top: 0px;
    margin-left: 8px;
    margin-right: 0px;
    background-color:#909AA7;
}

QTabBar::tab:only-one
{
    margin-left:0px;
    color:#000000;
    background:transparent;
}

QTabWidget::tab-bar {
    alignment: left;
}