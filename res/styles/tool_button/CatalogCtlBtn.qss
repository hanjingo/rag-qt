/* QToolButton 基础样式 */
QToolButton#toggleMenuBtn {
    background-color: #383838;            /* 默认暗灰背景 */
    border: 1px solid #555555;            /* 淡灰色圆角边框 */
    border-radius: 6px;                   /* 圆角弧度 */
    padding: 4px;                         /* 内边距 */
    qproperty-iconSize: 20px 20px;        /* 设置图标大小 (根据需求调整) */
    qproperty-toolButtonStyle: ToolButtonIconOnly; /* 仅显示图标 */
}

/* 鼠标悬停 (Hover) 状态 */
QToolButton#toggleMenuBtn:hover {
    background-color: #4a4a4a;            /* 稍微变亮 */
    border-color: #777777;                /* 边框高亮 */
}

/* 鼠标按下 (Pressed) 状态 */
QToolButton#toggleMenuBtn:pressed {
    background-color: #2b2b2b;            /* 变暗，产生按下沉浸感 */
    border-color: #444444;
}

/* 选中/展开状态 (:checked) - 如果设置了 button->setCheckable(true) */
QToolButton#toggleMenuBtn:checked {
    background-color: #2a2a2a;            /* 选中时的深色背景 */
    border-color: #007acc;                /* 可加蓝色或高亮边框标识当前为“收起/展开”激活状态 */
}

QToolButton#toggleMenuBtn:checked:hover {
    background-color: #333333;
    border-color: #1c97ea;
}

/* 禁用 (Disabled) 状态 */
QToolButton#toggleMenuBtn:disabled {
    background-color: #2a2a2a;
    border-color: #3a3a3a;
    opacity: 0.5;
}