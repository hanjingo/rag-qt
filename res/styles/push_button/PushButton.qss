QPushButton
{
    background-color:#008273;
    color:rgb(255, 255, 255);
    border-radius:10px;
    border-style:outset;
    font-family:"微软雅黑";
    font-size: 20px;

    width: 150px;
    height: 35px;
    min-width: 150px;
    min-height: 35px;
}

QPushButton:pressed
{
    background-color:#57698C;
    border-style: inset;
}

QPushButton:!enabled
{
    background-color:rgb(204, 204, 204);
    border-style: inset;
}
